GEMINI_API_KEY=your_gemini_api_key_here
# Image-to-3D for products that have photos but no merchant USDZ
MESHY_API_KEY=
MESHY_MODEL=meshy-6-lite
# Commerce MCP transport: auto (Shop MCP first, Catalog MCP fallback) | shop | catalog
SHOPIFY_TRANSPORT=auto
SHOP_MCP_URL=https://mcp.shop.com/
SHOPIFY_COUNTRY=US
SHOPIFY_CURRENCY=USD
# Optional: Shopify Catalog API credentials for higher rate limits
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_AGENT_PROFILE=https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json
# CORS / local iOS simulator
CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8000